.SH NAME
ibv_query_gid \- query an InfiniBand port\(cqs GID table
.SH SYNOPSIS
.IP
.EX
#include \f[B]<infiniband/verbs.h>\f[R]

int ibv_query_gid(\f[B]struct\f[R] ibv_context *context,
                  uint8_t port_num,
                  int index,
                  \f[B]union\f[R] ibv_gid *gid);
.EE
.SH DESCRIPTION
\f[B]ibv_query_gid()\f[R] returns the GID value in entry \f[I]index\f[R]
of port \f[I]port_num\f[R] for device context \f[I]context\f[R] through
the pointer \f[I]gid\f[R].
.SH RETURN VALUE
\f[B]ibv_query_gid()\f[R] returns 0 on success, and \-1 on error.
